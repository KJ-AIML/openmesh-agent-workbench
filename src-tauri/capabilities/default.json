{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for Openmesh v0.3.0 — file-based storage + window controls.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "core:window:allow-toggle-maximize",
    "core:window:allow-start-dragging",
    "core:window:allow-is-maximized",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-ask",
    "dialog:allow-confirm",
    "dialog:allow-message",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-read-dir",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-exists",
    "fs:scope-home",
    "fs:scope-home-recursive",
    {
      "identifier": "fs:scope",
      "deny": [
        "$HOME/.ssh",
        "$HOME/.ssh/**",
        "$CONFIG/openmesh/agent-api-key",
        "$HOME/.config/openmesh/agent-api-key"
      ]
    }
  ]
}
